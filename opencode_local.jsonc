{
  "$schema": "https://opencode.ai/config.json",

  // --- Work-only overrides (gitignored) ---
  // This file is loaded via OPENCODE_CONFIG env var and deep-merges on top
  // of opencode.jsonc. It is never committed to git.

  // --- Model ---
  "model": "proxy_openai/gpt-5-4-petrobras",
  "default_agent": "generalist",

  // --- Skills ---
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },

  // --- MCP (machine-local) ---
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-af45b65b-e437-4cbe-95f7-2f5b5ef002cb"
      },
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\BTNY"
      ],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "--system-certs",
        "--default-index",
        "https://jfrog.petrobras.dev.br/artifactory/api/pypi/pypi-group-all/simple",
        "mcp-server-git"
      ],
      "enabled": true
    }
  },

  // --- Providers ---
  "provider": {
    "proxy_bedrock": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Corporate API",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "anything"
      },
      "models": {
        "us.anthropic.claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Corp)"
        },
        "us.anthropic.claude-sonnet-4-5-20250929-v1:0": {
          "name": "Claude Sonnet 4.5 (Corp)"
        },
        "us.anthropic.claude-haiku-4-5-20251001-v1:0": {
          "name": "Claude Haiku 4.5 (Corp)"
        }
      }
    },

    "APIM-Bedrock": {
      "name": "APIM - Bedrock",
      "npm": "@ai-sdk/amazon-bedrock",
      "options": {
        "baseURL": "https://apit.petrobras.com.br/ia/generativos/v1/aws-bedrock/request-signer/bedrock-runtime",
        "region": "us-east-1",
        "apiKey":  "d25c2a69dafa4049b5204b847088c8b0",
        "headers": {
          "Ocp-Apim-Subscription-Key": "d25c2a69dafa4049b5204b847088c8b0",
          "x-ptb-aws-service": "bedrock-runtime",
          "x-ptb-aws-region": "us-east-1",
          "apikey": "d25c2a69dafa4049b5204b847088c8b0"
        }
      },
      "models": {
        "us.anthropic.claude-sonnet-4-5-20250929-v1:0": {
          "name": "Claude 4.5 Sonnet"
        },
        "us.anthropic.claude-sonnet-4-6": {
          "name": "Claude 4.6 Sonnet"
        },
        "us.anthropic.claude-haiku-4-5-20251001-v1:0": {
          "name": "Claude 4.5 Haiku"
        }
      }
    },

    "proxy_openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Petrobras Hub (proxy)",
      "options": {
        "baseURL": "http://localhost:8005/v1",
        "apiKey": "anything"
      },
      "models": {
        "gpt-4o-petrobras": {
          "name": "GPT-4o (Petrobras)"
        },
        "gpt-4-1-petrobras": {
          "name": "GPT-4.1 (Petrobras)"
        },
        "gpt-4-1-mini-petrobras": {
          "name": "GPT-4.1 Mini (Petrobras)"
        },
        "gpt-4-1-nano-petrobras": {
          "name": "GPT-4.1 Nano (Petrobras)"
        },
        "gpt-5-petrobras": {
          "name": "GPT-5 (Petrobras)"
        },
        "gpt-5-mini-petrobras": {
          "name": "GPT-5 Mini (Petrobras)"
        },
        "gpt-5-4-nano-petrobras": {
          "name": "GPT-5.4 Nano (Petrobras)"
        },
        "gpt-5-2-petrobras": {
          "name": "GPT-5.2 (Petrobras)"
        },
        "gpt-5-4-petrobras": {
          "name": "GPT-5.4 (Petrobras)"
        },
        "o3-petrobras": {
          "name": "o3 (Petrobras)"
        },
        "o4-mini-petrobras": {
          "name": "o4-mini (Petrobras)"
        }
      }
    },

    "petrobras": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Petrobras Chat (proxy)",
      "options": {
        "baseURL": "http://localhost:8787/v1",
        "apiKey": "anything"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Petrobras)"
        }
      }
    }
  }
}
